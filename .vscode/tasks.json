{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build (Debug, deploy to Gale dev profile)",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "-c", "Debug"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Package (Release zip to /dist)",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "-c", "Release"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "problemMatcher": "$msCompile"
    }
  ]
}
