<Project Sdk="Microsoft.NET.Sdk">
  <!-- Framework, references, deploy and packaging come from Directory.Build.props/.targets. -->
  <PropertyGroup>
    <AssemblyName>QuanDupeLightsources</AssemblyName>
    <RootNamespace>QuanDupeLightsources</RootNamespace>

    <!-- The ONLY place to bump the version: feeds the plugin attribute and the generated manifest.json -->
    <Version>1.1.0</Version>

    <!-- Thunderstore manifest description: max 250 characters, no double quotes. -->
    <ThunderstoreDescription>Adds (Always Lit) duplicates of the vanilla and QuanPieces light sources NoSmokeStayLit can put on a timer, for use with its Custom Items Keep Lit list.</ThunderstoreDescription>
    <!-- Becomes website_url in manifest.json: the Thunderstore page's link to the repo (and its Issues).
         Leave empty to use this repo's git remote automatically; set it only to point somewhere else. -->
    <RepoUrl></RepoUrl>
  </PropertyGroup>

  <!-- Extra Thunderstore dependencies beyond BepInExPack and Jotunn (both added automatically). Versions come
       from this mod's Gale profile; add -x.y.z to pin one. -->
  <ItemGroup>
    <!-- Its street lights are cloned here; must load first (see BepInDependency in the plugin). -->
    <ThunderstoreDependency Include="Quandru-QuanPieces" />
    <!-- The twins exist only to split its lit and timed behaviour. -->
    <ThunderstoreDependency Include="TastyChickenLegs-NoSmokeStayLit" />
  </ItemGroup>
</Project>
