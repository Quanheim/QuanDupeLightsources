<Project Sdk="Microsoft.NET.Sdk">
  <!-- Framework, references, deploy and packaging come from Directory.Build.props/.targets. -->
  <PropertyGroup>
    <AssemblyName>MyValheimPlugin</AssemblyName>
    <RootNamespace>MyValheimPlugin</RootNamespace>

    <!-- The ONLY place to bump the version: feeds the plugin attribute and the generated manifest.json -->
    <Version>1.0.0</Version>

    <!-- Thunderstore manifest description: max 250 characters, no double quotes. -->
    <ThunderstoreDescription>Describe the mod here.</ThunderstoreDescription>
    <!-- This mod's GitHub repo URL. Becomes website_url in manifest.json: the link on the Thunderstore
         page that sends players to the repo (and its Issues). Set it as soon as the repo exists. -->
    <RepoUrl></RepoUrl>
  </PropertyGroup>

  <!-- Extra Thunderstore dependencies beyond BepInExPack and Jotunn (both added automatically), e.g.
  <ItemGroup>
    <ThunderstoreDependency Include="Author-ModName-1.2.3" />
  </ItemGroup>
  -->
</Project>
