<Project Sdk="Microsoft.NET.Sdk">
  <!-- Framework, references, deploy and packaging come from Directory.Build.props/.targets. -->
  <PropertyGroup>
    <AssemblyName>QuanDupeLightsources</AssemblyName>
    <RootNamespace>QuanDupeLightsources</RootNamespace>

    <!-- The ONLY place to bump the version: feeds the plugin attribute and the generated manifest.json -->
    <Version>1.0.0</Version>

    <!-- Thunderstore manifest description: max 250 characters, no double quotes. -->
    <ThunderstoreDescription>Adds (Always Lit) duplicates of vanilla fire pieces for use with NoSmokeStayLit's Custom Items Keep Lit list.</ThunderstoreDescription>
    <!-- Becomes website_url in manifest.json: the Thunderstore page's link to the repo (and its Issues).
         Leave empty to use this repo's git remote automatically; set it only to point somewhere else. -->
    <RepoUrl></RepoUrl>
  </PropertyGroup>

  <!-- Extra Thunderstore dependencies beyond BepInExPack and Jotunn (added automatically), e.g.
  <ItemGroup>
    <ThunderstoreDependency Include="TastyChickenLegs-NoSmokeStayLit-2.4.2" />
  </ItemGroup>
  -->
</Project>
